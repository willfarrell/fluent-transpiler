{
	"license": ".license.template",
	"licenseFormats": {
		"js|ts": {
			"eachLine": {
				"prepend": "// "
			}
		}
	},
	"ignoreFile": ".gitignore",
	"ignore": [
		".github/**/*",
		".husky/**/*",
		"test/files/**/*",
		"commitlint.config.cjs",
		"LICENSE",
		".license.template",
		"stryker.config.*",
		"**/.gitignore",
		"**/*.fuzz.js",
		"**/*.perf.js",
		"**/*.test.js",
		"**/*.md",
		"**/*.yml",
		"**/.DS_Store",
		"**/*.ftl",
		"**/*.mjs"
	]
}
