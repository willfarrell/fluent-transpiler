{
	"$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
	"packageManager": "npm",
	"testRunner": "command",
	"commandRunner": {
		"command": "node --test --test-force-exit ./**/*.test.js"
	},
	"coverageAnalysis": "off",
	"disableTypeChecks": false,
	"tempDirName": "/tmp/stryker/fluent-transpiler",
	"mutate": ["index.js", "program.js"],
	"reporters": ["progress", "clear-text"],
	"thresholds": {
		"high": 100,
		"low": 100,
		"break": 100
	}
}
